  "type": "module",
  "scripts": {
    "audit:all": "pnpm audit",
    "dev": "vp dev",
    "build": "vp run type-check && vp run build:client && vp run build:ssr && vp run prerender",
    "build:client": "vp build",
    "build:ssr": "vp build --ssr src/entry-server.ts --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vp preview",
    "type-check": "vue-tsc --build",
    "check": "vp check",
    "test": "vp test",
    "format": "vp fmt",
    "docs:build": "pnpm build",
    "verify": "vp check && vp test && pnpm build",
    "release:verify": "pnpm audit:all && pnpm verify"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lucide/vue": "^1.38.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.42",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
