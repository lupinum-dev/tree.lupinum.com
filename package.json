    "@vue/server-renderer": "3.5.42",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^20.11.1",
    "typescript": "~6.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0",
    "vue-tsc": "^3.3.8",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.12.0 || ^26.0.0"
  },
  "packageManager": "pnpm@11.23.0"
